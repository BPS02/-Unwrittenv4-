# ── OpenRouter (follow-up questions + lyrics + music prompt) ──────────────
# Get a key at https://openrouter.ai/keys
# If absent, lyrics and the music brief fall back to deterministic local
# generation (Demo Mode) — but the "Questions" step CANNOT: its questions are
# written from what each person wrote, and a canned list would read as
# personal when it isn't. Without a key that step reports an error and offers
# to write the lyrics without it, so a keyless deployment can still finish.
OPENROUTER_API_KEY=
# Any OpenRouter chat model id. Default shown.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: a different model for lyric generation only; falls back to
# OPENROUTER_MODEL when unset. The music brief always uses OPENROUTER_MODEL.
OPENROUTER_LYRICS_MODEL=
# Optional attribution headers OpenRouter recommends for app rankings.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Unwritten

# ── Neon Postgres (entitlements + songs) ─────────────────────────────────
# Create a project at https://neon.tech, or add the Neon integration in the
# Vercel dashboard, which sets this automatically.
# Use the POOLED connection string (the host containing "-pooler"): every
# serverless invocation is its own instance, and direct connections exhaust
# the server limit quickly.
# If absent, the app degrades honestly to an in-memory store — fine for local
# dev and the test suite, but state vanishes on restart.
DATABASE_URL=

# Apply the schema once DATABASE_URL is set:
#   npm run db:migrate

# ── Langfuse (prompt versioning + tracing) — optional ─────────────────────
# Create a project at https://cloud.langfuse.com (or self-host).
# If absent, local prompt templates are used and no traces are sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Observation attributes used for filtering and release comparisons in v4.
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
# V4 runs the whole flow on TWO managed prompts (both chat prompts with a
# `production` label). Each must be its OWN prompt in YOUR Langfuse project;
# if a prompt does not exist, the built-in fallback in lib/prompts.ts is used.
#
# THE GUIDE walks the writer through telling the personal detail (the
# follow-up questions) and then puts it all together into the song brief.
LANGFUSE_GUIDE_PROMPT_NAME=unwritten-guide
# THE GENERATOR writes the song from that brief in one completion: title,
# the STYLE production brief handed to the music provider, and the lyrics.
# There is no separate music prompt. (These two are the only prompts — the
# starter templates are hand-curated in lib/templates.ts, no model involved.)
LANGFUSE_GENERATOR_PROMPT_NAME=unwritten-generator

# ── Music generation provider — optional ──────────────────────────────────
# "demo" (default): no external audio API; the browser synthesizes a short
#   instrumental sketch locally and shows the constructed music prompt.
# "elevenlabs": uses the ElevenLabs Music API (requires ELEVENLABS_API_KEY).
# "gpt-audio": OpenAI's voice model via OpenRouter performs the lyrics as an
#   expressive vocal rendition (no instrumental track; reuses OPENROUTER_API_KEY).
# "lyria": Google Lyria 3 via OpenRouter — full songs with vocals and
#   instrumental backing, 48kHz, ~$0.08/song (reuses OPENROUTER_API_KEY).
# "mureka": Mureka lyrics-first song generation (requires MUREKA_API_KEY
#   from https://platform.mureka.ai).
MUSIC_PROVIDER=demo
# Optional override for the lyria provider's model id.
LYRIA_MODEL=google/lyria-3-pro-preview
ELEVENLABS_API_KEY=
MUREKA_API_KEY=
# Voice for gpt-audio renders (alloy, ash, ballad, coral, echo, sage, shimmer, verse).
GPT_AUDIO_VOICE=alloy
# Length of generated track in milliseconds (elevenlabs provider only).
MUSIC_LENGTH_MS=30000
# ── Home page hero video — optional ──────────────────────────────────────
# An ambient looping clip behind the landing page. Point at a file in
# /public; unset removes the <video> entirely and the page keeps its still.
# NEXT_PUBLIC_ because it is read at build time in a client component.
# Hidden on phones and for prefers-reduced-motion — see app/globals.css.
NEXT_PUBLIC_HERO_VIDEO=
# Defaults to /images/home-twilight.png, the still already on the page, so
# the first paint is identical whether or not the video loads.
NEXT_PUBLIC_HERO_POSTER=

# ── Clerk authentication ────────────────────────────────────────────────
# Identity and sessions only; Clerk does not store songs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/create
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/create

# Public generation limits. The current limiter is in-memory per server instance.
RATE_LIMIT_DEVICE_PER_HOUR=10
RATE_LIMIT_IP_PER_HOUR=30

# ── Stripe billing (subscription + song pack) — optional ────────────────
# Without these the app builds and runs normally; all users are treated as
# free-tier and the paywall shows a calm "billing not configured" state.
# Secret keys are server-side only — never referenced from client code.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Dashboard → Webhooks, or
# `stripe listen --forward-to localhost:3000/api/billing/webhook`).
STRIPE_WEBHOOK_SECRET=
# Price ids created in the Stripe Dashboard (Products):
#   Song Pass $9.99, Pro $19/month, and 10-credit pack $7.99.
STRIPE_PRICE_SONG_PASS=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_CREDIT_PACK=
# Public origin used for checkout success/cancel URLs (falls back to the
# request origin in dev).
APP_URL=http://localhost:3000

# ── Audio storage ────────────────────────────────────────────────────────
# Audio bytes live in Postgres (audio_blobs), so DATABASE_URL is all that is
# required. Optional: a dedicated key for signing playback tokens. Without it
# DATABASE_URL is used, which is present whenever audio can exist at all.
# Rotating either invalidates live playback tokens; they expire in an hour.
AUDIO_SIGNING_SECRET=
# LEGACY. Only needed to keep serving takes rendered before audio moved into
# Postgres — they still carry a Blob pathname. Nothing new is written here,
# and once those takes are re-rendered or migrated this can be removed.
BLOB_READ_WRITE_TOKEN=

# ── Abuse guards ─────────────────────────────────────────────────────────
# Hard ceiling on real (billed) music renders per UTC day across the whole
# app, so a shared link can't create an unbounded provider bill.
MAX_DAILY_RENDERS=200
# Optional: POSTed a JSON alert the first time the ceiling is hit each day.
ALERT_WEBHOOK_URL=
